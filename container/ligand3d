#!/usr/bin/env bash
#
# ligand3d launcher.
#
# Put this directory on your PATH and `ligand3d` works with nothing installed:
#
#     export PATH=/net/software/containers/users/woodbuse/ligand3d:$PATH
#     ligand3d build "O=C1CN2CCC1CC2" -o quin.cif
#
# It picks an image from the backend you asked for, because the neural
# potentials cannot share an environment. MMFF94, UFF, GFN-FF, GFN1, GFN2,
# protonation, name lookup, the sketcher, Rosetta params and the annotated CIF
# all live in ligand3d.sif; MACE and AIMNet2 come from the lab's quantum_chem
# image, and eSEN/UMA/AllScAIP from the uma image.
#
# The source is baked into ligand3d.sif, so a run is pinned to a version rather
# than to whatever happens to be checked out. When dispatching to one of the
# other images, the package is copied *out of that same sif* into a cache, so
# the code cannot drift from the image it was released with.

set -euo pipefail

HERE="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"

CORE_SIF="${LIGAND3D_SIF:-$HERE/ligand3d.sif}"
MACE_SIF="${LIGAND3D_SIF_MACE:-/net/software/containers/users/woodbuse/quantum_chem/quantum_chem-20260604.sif}"
FAIRCHEM_SIF="${LIGAND3D_SIF_FAIRCHEM:-/net/software/containers/users/woodbuse/quantum_chem/uma-20260527.sif}"
CACHE="${LIGAND3D_LAUNCHER_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/ligand3d/launcher}"

die() { printf 'ligand3d: %s\n' "$*" >&2; exit 1; }

[[ -f $CORE_SIF ]] || die "no image at $CORE_SIF. Set LIGAND3D_SIF to point at one."
command -v apptainer >/dev/null || die "apptainer is not on PATH; this launcher needs it."

# --- which image? -----------------------------------------------------------
# Read the backend chain, then let the last unusual name in it decide. A chain
# is only ever cheap-then-expensive, so the expensive end is what needs the
# heavier image.
backend=""
wants_slurm=0
subcommand=""
port=""
no_browser=0
for ((i = 1; i <= $#; i++)); do
    case "${!i}" in -*) ;; *) [[ -z $subcommand ]] && subcommand="${!i}" ;; esac
    case "${!i}" in
        -b|--backend) j=$((i + 1)); [[ $j -le $# ]] && backend="${!j}" ;;
        --backend=*)  backend="${!i#--backend=}" ;;
        --slurm)      wants_slurm=1 ;;
        --port)       j=$((i + 1)); [[ $j -le $# ]] && port="${!j}" ;;
        --port=*)     port="${!i#--port=}" ;;
        --no-browser) no_browser=1 ;;
    esac
done

if [[ $wants_slurm == 1 ]]; then
    die "--slurm needs sbatch, which does not work inside a container: its auth
plugins cannot be reached from one. Submit from a checkout instead —
  git clone git@github.com:SethWoodbury/ligand3d && cd ligand3d
  uv pip install -e '.[xtb,protonation]'
Everything else here works unchanged."
fi

# ligand3d builds one image per family, each carrying the *whole* non-neural
# feature set — tblite, protonation, name lookup — so a chain like
# `gfn2,mace-off` runs in one place. The lab's general-purpose images are a
# fallback: they have the potentials but not the rest, so that same chain fails
# in them partway through.
family="core"
case ",${backend}," in
    *,esen*|*,uma-*|*,allscaip*)  family="fairchem" ;;
    *,mace*|*aimnet2*)            family="mace" ;;
esac

# The sketcher is the one command where the backend is chosen *after* the
# image is: you pick it in the browser. Landing in the core image would offer a
# menu of five, so it starts in the richest one available unless told
# otherwise. MACE is the default of the two neural families because it carries
# the most models; `sketch -b esen` gets the other side.
if [[ $subcommand == sketch && -z $backend ]]; then
    for candidate in mace fairchem; do
        [[ -f $HERE/ligand3d-$candidate.sif ]] && { family="$candidate"; break; }
    done
fi

# The sketcher's page is served from inside the container, but the browser
# that should show it lives out here. Nothing in the image can open one, and it
# cannot reach the host's, so `sketch` used to print a URL and leave you to it.
# The launcher runs on the host, so it can do the opening: wait for the port to
# answer, then hand it to whatever browser this machine has.
#
# --no-browser goes to the container either way, so it does not also print a
# line about having no browser — which is true in there and beside the point
# out here. It still prints the URL, and the ssh -L hint when the session is
# remote, which is the case no local browser can help with.
open_when_ready () {
    local candidates=(${1:-8765 8766 8767 8768 8769}) opener="" p=""
    for try in xdg-open gio open firefox google-chrome chromium; do
        command -v "$try" >/dev/null 2>&1 && { opener="$try"; break; }
    done
    [[ -n $opener ]] || return 0        # nothing to open with; the URL stands
    [[ -n ${SSH_CONNECTION:-} ]] && return 0   # a browser here is the wrong screen

    for _ in $(seq 1 120); do
        for p in "${candidates[@]}"; do
            if (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then
                exec 3<&- 2>/dev/null
                [[ $opener == gio ]] && set -- open "http://127.0.0.1:$p/" \
                                     || set -- "http://127.0.0.1:$p/"
                "$opener" "$@" >/dev/null 2>&1 &
                return 0
            fi
        done
        sleep 0.5
    done
}

sketch_args=("$@")
if [[ $subcommand == sketch && $no_browser == 0 ]]; then
    open_when_ready "$port" &
    sketch_args=("$@" --no-browser)
fi

own="$HERE/ligand3d-$family.sif"
[[ $family == core ]] && own="$CORE_SIF"

binds=()
for path in /home /net /mnt /projects /scratch; do
    [[ -d $path ]] && binds+=(--bind "$path:$path")
done
cwd="$(pwd -P)"
case "$cwd" in /home/*|/net/*|/mnt/*|/projects/*|/scratch/*) ;; *) binds+=(--bind "$cwd:$cwd") ;; esac

nv=()
[[ $family != core ]] && command -v nvidia-smi >/dev/null 2>&1 && nv=(--nv)

if [[ -f $own ]]; then
    # ligand3d is installed in this image, so nothing needs to be carried in.
    exec apptainer run "${nv[@]}" "${binds[@]}" --pwd "$cwd" \
        --env LIGAND3D_LAUNCHER=1 \
        --env "HF_HOME=${HF_HOME:-/net/databases/huggingface}" \
        --env TORCHDYNAMO_DISABLE=1 \
        "$own" "${sketch_args[@]}"
fi

# --- fallback: a lab image that has the potentials but not ligand3d ---------
image=""
case "$family" in
    mace)     image="$MACE_SIF" ;;
    fairchem) image="$FAIRCHEM_SIF" ;;
esac
[[ -n $image && -f $image ]] || die "backend '$backend' needs $own or a lab image,
and neither is here. Build one with container/build.sh, or choose a backend the
core image covers: mmff94, uff, gfnff, gfn1, gfn2, orca."

printf 'ligand3d: no %s, falling back to %s\n' "$(basename "$own")" "$(basename "$image")" >&2
printf '          that image lacks tblite and dimorphite-dl, so GFN1/GFN2 and pH\n' >&2
printf '          protonation are unavailable in it. Build the family image to fix.\n' >&2

# Copy the package out of the core sif, keyed by that image's identity, so a
# rebuilt image gets a fresh copy and a stale one is never reused.
stamp="$(stat -c '%Y-%s' "$CORE_SIF")"
payload="$CACHE/$stamp"
if [[ ! -d $payload/ligand3d ]]; then
    mkdir -p "$payload"
    apptainer exec --bind "$payload:/out" "$CORE_SIF" sh -c '
        set -e
        src=$(python -c "import ligand3d, os; print(os.path.dirname(ligand3d.__file__))")
        cp -r "$src" /out/
    ' || die "could not take the package out of $CORE_SIF"
fi

exec apptainer exec "${nv[@]}" "${binds[@]}" --bind "$payload:$payload" --pwd "$cwd" \
    --env "PYTHONPATH=$payload" \
    --env "HF_HOME=${HF_HOME:-/net/databases/huggingface}" \
    --env TORCHDYNAMO_DISABLE=1 \
    --env PYTHONNOUSERSITE=1 \
    "$image" python -m ligand3d.cli "${sketch_args[@]}"
